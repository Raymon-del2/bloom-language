{
  "name": "@bloom/seed",
  "version": "1.0.0",
  "description": "CLI for Bloom seed creation and management",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "bloom-seed": "./bin/seed.js",
    "bloom-init": "./bin/init.js",
    "bloom-crystal": "./bin/crystal.js",
    "bloom-sprout": "./bin/sprout.js"
  },
  "scripts": {
    "dev": "tsc --watch",
    "build": "tsc",
    "test": "vitest",
    "lint": "eslint src/**/*.ts",
    "format": "prettier --write src/**/*.ts"
  },
  "keywords": [
    "bloom",
    "seed",
    "cli",
    "local-first",
    "ai"
  ],
  "author": "Bloom Team",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/bloom/bloom-framework.git",
    "directory": "packages/seed"
  },
  "dependencies": {
    "commander": "^11.0.0",
    "chalk": "^5.3.0",
    "ora": "^7.0.1",
    "inquirer": "^9.2.0",
    "fs-extra": "^11.1.0"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/fs-extra": "^11.0.0",
    "typescript": "^5.3.0",
    "vitest": "^1.0.0",
    "eslint": "^8.0.0",
    "prettier": "^3.0.0"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
