---
const { title = "Dashboard" } = Astro.props;
---

<div class="vines-demo">
  <div class="bloom-vines vine-container">
    <header class="crystal-header">
      <div class="header-accent"></div>
      <div class="header-content">
        <div class="header-icon">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M12 2L2 7l10 5 10-5-10-5z"/>
            <path d="M2 17l10 5 10-5"/>
            <path d="M2 12l10 5 10-5"/>
          </svg>
        </div>
        <div class="header-text">
          <h2>{title}</h2>
          <span class="header-subtitle">Crystalized</span>
        </div>
      </div>
      <div class="header-vine vine-left"></div>
      <div class="header-vine vine-right"></div>
    </header>
    
    <div class="vines-grid">
      <div class="vine-card">
        <div class="vine-indicator active"></div>
        <span class="vine-label">Seed</span>
        <span class="vine-status">Active</span>
      </div>
      <div class="vine-card">
        <div class="vine-indicator"></div>
        <span class="vine-label">Sieve</span>
        <span class="vine-status">Ready</span>
      </div>
    </div>
  </div>
</div>

<style>
  .vines-demo {
    padding: 1rem;
    min-width: 240px;
  }

  .bloom-vines {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  /* Crystal Header */
  .crystal-header {
    background: linear-gradient(135deg, rgba(255, 255, 255, 0.12) 0%, rgba(255, 255, 255, 0.04) 100%);
    backdrop-filter: blur(20px) saturate(200%);
    border: 1px solid rgba(255, 255, 255, 0.18);
    border-radius: 16px;
    padding: 1.25rem;
    position: relative;
    overflow: hidden;
    transition: all 0.4s cubic-bezier(0.23, 1, 0.32, 1);
  }

  .crystal-header:hover {
    transform: translateY(-3px);
    box-shadow: 
      0 25px 50px rgba(0, 0, 0, 0.3),
      0 0 40px rgba(16, 185, 129, 0.15);
    border-color: rgba(16, 185, 129, 0.4);
  }

  .header-accent {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 3px;
    background: linear-gradient(90deg, #10b981, #00d4ff, #8b5cf6);
    opacity: 0.8;
  }

  .header-content {
    display: flex;
    align-items: center;
    gap: 1rem;
    position: relative;
    z-index: 2;
  }

  .header-icon {
    width: 44px;
    height: 44px;
    background: linear-gradient(135deg, rgba(16, 185, 129, 0.2) 0%, rgba(0, 212, 255, 0.2) 100%);
    border-radius: 12px;
    display: flex;
    align-items: center;
    justify-content: center;
    color: #10b981;
    border: 1px solid rgba(16, 185, 129, 0.3);
  }

  .header-icon svg {
    width: 24px;
    height: 24px;
  }

  .header-text {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }

  .header-text h2 {
    margin: 0;
    font-size: 1.1rem;
    font-weight: 600;
    color: #fff;
    letter-spacing: -0.02em;
  }

  .header-subtitle {
    font-size: 0.75rem;
    color: #10b981;
    text-transform: uppercase;
    letter-spacing: 0.15em;
    font-weight: 500;
  }

  /* Decorative vines */
  .header-vine {
    position: absolute;
    width: 60px;
    height: 60px;
    border: 2px solid transparent;
    border-radius: 50%;
    opacity: 0.3;
    transition: all 0.4s ease;
  }

  .vine-left {
    bottom: -20px;
    left: -20px;
    border-top-color: rgba(16, 185, 129, 0.5);
    border-left-color: rgba(16, 185, 129, 0.5);
    animation: vine-rotate 8s linear infinite;
  }

  .vine-right {
    top: -20px;
    right: -20px;
    border-bottom-color: rgba(0, 212, 255, 0.5);
    border-right-color: rgba(0, 212, 255, 0.5);
    animation: vine-rotate 8s linear infinite reverse;
  }

  @keyframes vine-rotate {
    from { transform: rotate(0deg); }
    to { transform: rotate(360deg); }
  }

  .crystal-header:hover .header-vine {
    opacity: 0.6;
  }

  /* Vines Grid */
  .vines-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0.75rem;
  }

  .vine-card {
    background: rgba(255, 255, 255, 0.05);
    backdrop-filter: blur(10px);
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: 12px;
    padding: 1rem;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    transition: all 0.3s ease;
  }

  .vine-card:hover {
    background: rgba(255, 255, 255, 0.08);
    transform: translateY(-2px);
  }

  .vine-indicator {
    width: 10px;
    height: 10px;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.2);
    transition: all 0.3s ease;
  }

  .vine-indicator.active {
    background: #10b981;
    box-shadow: 0 0 10px rgba(16, 185, 129, 0.5);
    animation: pulse-indicator 2s ease-in-out infinite;
  }

  @keyframes pulse-indicator {
    0%, 100% { transform: scale(1); opacity: 1; }
    50% { transform: scale(1.2); opacity: 0.8; }
  }

  .vine-label {
    font-size: 0.8rem;
    font-weight: 600;
    color: rgba(255, 255, 255, 0.9);
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .vine-status {
    font-size: 0.75rem;
    color: rgba(255, 255, 255, 0.5);
  }
</style>
