---
interface FeatureShowcaseProps {
  code: string;
  title?: string;
  delay?: number;
}

const { code, title = 'Bloom Markup', delay = 0 } = Astro.props;

const codeId = `showcase-${Math.random().toString(36).substr(2, 9)}`;
---

<figure class="feature-showcase" data-code={code} data-delay={delay} data-code-id={codeId}>
  <div class="showcase-container">
    <!-- Left Side: Code Editor (Liquid) -->
    <div class="code-side">
      <div class="code-editor floating-glass">
        <div class="glass-sweep"></div>
        <div class="editor-header">
          <div class="window-controls">
            <div class="dot red"></div>
            <div class="dot yellow"></div>
            <div class="dot green"></div>
          </div>
          <span class="editor-title">{title}</span>
        </div>
        <div class="editor-content">
          <div class="line-numbers">
            <span>1</span>
            <span>2</span>
            <span>3</span>
          </div>
          <div class="code-area">
            <code class="typewriter-code" data-code={code}></code>
            <span class="cursor"></span>
          </div>
        </div>
      </div>
    </div>

    <!-- Neural Connection Line -->
    <div class="neural-connection">
      <svg class="neural-svg" viewBox="0 0 100 200" preserveAspectRatio="none">
        <defs>
          <linearGradient id="neural-gradient" x1="0%" y1="0%" x2="100%" y2="0%">
            <stop offset="0%" style="stop-color:#00d4ff;stop-opacity:0.8" />
            <stop offset="50%" style="stop-color:#8b5cf6;stop-opacity:1" />
            <stop offset="100%" style="stop-color:#10b981;stop-opacity:0.8" />
          </linearGradient>
          <filter id="glow">
            <feGaussianBlur stdDeviation="3" result="coloredBlur"/>
            <feMerge>
              <feMergeNode in="coloredBlur"/>
              <feMergeNode in="SourceGraphic"/>
            </feMerge>
          </filter>
        </defs>
        <path 
          class="neural-path" 
          d="M 10 100 Q 50 100 50 50 Q 50 0 90 0" 
          fill="none" 
          stroke="url(#neural-gradient)" 
          stroke-width="2"
          filter="url(#glow)"
          stroke-linecap="round"
        />
        <circle class="pulse-dot" cx="10" cy="100" r="4" fill="#00d4ff" filter="url(#glow)" />
        <circle class="pulse-dot-end" cx="90" cy="0" r="4" fill="#10b981" filter="url(#glow)" opacity="0" />
      </svg>
    </div>

    <!-- Right Side: UI Preview (Solid) -->
    <div class="preview-side">
      <div class="preview-container solid-panel">
        <div class="preview-label">Live Preview</div>
        <div class="preview-content">
          <slot />
        </div>
      </div>
    </div>
  </div>
  
  <figcaption class="showcase-caption">
    <slot name="caption" />
  </figcaption>
</figure>

<style>
  .feature-showcase {
    margin: 3rem 0;
    padding: 0;
    border: none;
  }

  .showcase-container {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    gap: 1rem;
    align-items: center;
    min-height: 300px;
  }

  /* Left Side - Code Editor (Liquid feel) */
  .code-side {
    perspective: 1000px;
  }

  .code-editor {
    background: rgba(29, 30, 34, 0.9);
    backdrop-filter: blur(20px) saturate(180%);
    border: 1px solid rgba(0, 212, 255, 0.15);
    border-radius: 16px;
    padding: 1.5rem;
    transform: perspective(1000px) rotateY(8deg) rotateX(-2deg);
    transition: transform 0.5s cubic-bezier(0.23, 1, 0.32, 1);
    box-shadow: 
      -20px 20px 60px rgba(0, 0, 0, 0.4),
      0 0 0 1px rgba(0, 212, 255, 0.1),
      inset 0 1px 0 rgba(255, 255, 255, 0.05);
    position: relative;
    overflow: hidden;
    animation: liquid-float 6s ease-in-out infinite;
  }

  @keyframes liquid-float {
    0%, 100% { transform: perspective(1000px) rotateY(8deg) rotateX(-2deg) translateY(0px); }
    50% { transform: perspective(1000px) rotateY(8deg) rotateX(-2deg) translateY(-6px); }
  }

  .code-editor:hover {
    transform: perspective(1000px) rotateY(4deg) rotateX(-1deg) translateY(-8px);
    box-shadow: 
      -30px 30px 80px rgba(0, 0, 0, 0.5),
      0 0 40px rgba(0, 212, 255, 0.1),
      inset 0 1px 0 rgba(255, 255, 255, 0.1);
  }

  /* Glass sweep effect */
  .glass-sweep {
    position: absolute;
    top: 0;
    left: -100%;
    width: 50%;
    height: 100%;
    background: linear-gradient(
      120deg,
      transparent 0%,
      rgba(0, 212, 255, 0.03) 45%,
      rgba(0, 212, 255, 0.08) 50%,
      rgba(0, 212, 255, 0.03) 55%,
      transparent 100%
    );
    animation: sweep 4s ease-in-out infinite;
    pointer-events: none;
  }

  @keyframes sweep {
    0%, 100% { left: -100%; }
    50% { left: 200%; }
  }

  .editor-header {
    display: flex;
    align-items: center;
    gap: 1rem;
    margin-bottom: 1rem;
    padding-bottom: 0.75rem;
    border-bottom: 1px solid rgba(255, 255, 255, 0.06);
  }

  .window-controls {
    display: flex;
    gap: 0.5rem;
  }

  .dot {
    width: 12px;
    height: 12px;
    border-radius: 50%;
  }

  .dot.red { background: #ff5f56; }
  .dot.yellow { background: #ffbd2e; }
  .dot.green { background: #27c93f; }

  .editor-title {
    font-size: 0.75rem;
    color: rgba(255, 255, 255, 0.4);
    font-family: 'JetBrains Mono', monospace;
  }

  .editor-content {
    display: flex;
    gap: 1rem;
    font-family: 'JetBrains Mono', 'Fira Code', monospace;
    font-size: 0.875rem;
    line-height: 1.8;
  }

  .line-numbers {
    display: flex;
    flex-direction: column;
    color: rgba(255, 255, 255, 0.2);
    text-align: right;
    user-select: none;
  }

  .code-area {
    flex: 1;
    color: #e2e8f0;
  }

  .typewriter-code {
    display: inline;
    min-height: 1.6em;
  }

  .cursor {
    display: inline-block;
    width: 8px;
    height: 1.2em;
    background: #00d4ff;
    margin-left: 2px;
    vertical-align: text-bottom;
    animation: blink 1s step-end infinite;
  }

  @keyframes blink {
    0%, 100% { opacity: 1; }
    50% { opacity: 0; }
  }

  /* Neural Connection */
  .neural-connection {
    width: 100px;
    height: 200px;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .neural-svg {
    width: 100%;
    height: 100%;
    overflow: visible;
  }

  .neural-path {
    stroke-dasharray: 200;
    stroke-dashoffset: 200;
    animation: draw 3s ease-in-out infinite;
  }

  @keyframes draw {
    0% { stroke-dashoffset: 200; }
    50% { stroke-dashoffset: 0; }
    100% { stroke-dashoffset: -200; }
  }

  .pulse-dot {
    animation: pulse 2s ease-in-out infinite;
  }

  @keyframes pulse {
    0%, 100% { transform: scale(1); opacity: 1; }
    50% { transform: scale(1.5); opacity: 0.5; }
  }

  /* Right Side - Preview (Solid feel) */
  .preview-side {
    perspective: 1000px;
  }

  .preview-container {
    background: linear-gradient(145deg, rgba(255, 255, 255, 0.1) 0%, rgba(255, 255, 255, 0.05) 100%);
    backdrop-filter: blur(10px);
    border: 1px solid rgba(255, 255, 255, 0.15);
    border-radius: 20px;
    padding: 2rem;
    transform: perspective(1000px) rotateY(-8deg) rotateX(2deg);
    transition: transform 0.5s cubic-bezier(0.23, 1, 0.32, 1);
    box-shadow: 
      20px 20px 60px rgba(0, 0, 0, 0.4),
      0 0 0 1px rgba(16, 185, 129, 0.1),
      inset 0 1px 0 rgba(255, 255, 255, 0.1);
    position: relative;
    animation: solid-float 6s ease-in-out infinite;
    animation-delay: -3s;
  }

  @keyframes solid-float {
    0%, 100% { transform: perspective(1000px) rotateY(-8deg) rotateX(2deg) translateY(0px); }
    50% { transform: perspective(1000px) rotateY(-8deg) rotateX(2deg) translateY(-6px); }
  }

  .preview-container:hover {
    transform: perspective(1000px) rotateY(-4deg) rotateX(1deg) translateY(-8px);
    box-shadow: 
      30px 30px 80px rgba(0, 0, 0, 0.5),
      0 0 40px rgba(16, 185, 129, 0.15),
      inset 0 1px 0 rgba(255, 255, 255, 0.15);
  }

  .preview-label {
    position: absolute;
    top: -12px;
    left: 50%;
    transform: translateX(-50%);
    background: linear-gradient(135deg, #10b981 0%, #059669 100%);
    color: white;
    font-size: 0.75rem;
    font-weight: 600;
    padding: 0.25rem 1rem;
    border-radius: 20px;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    box-shadow: 0 4px 15px rgba(16, 185, 129, 0.4);
  }

  .preview-content {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    min-height: 150px;
  }

  .showcase-caption {
    margin-top: 1.5rem;
    text-align: center;
    color: rgba(255, 255, 255, 0.6);
    font-size: 0.875rem;
  }

  /* Responsive */
  @media (max-width: 768px) {
    .showcase-container {
      grid-template-columns: 1fr;
      gap: 2rem;
    }

    .neural-connection {
      transform: rotate(90deg);
      height: 100px;
    }

    .code-editor,
    .preview-container {
      transform: none !important;
      animation: none;
    }
  }
</style>

<script>
  // Typewriter effect for code
  const initShowcaseTypewriter = (showcase) => {
    const codeElement = showcase.querySelector('.typewriter-code');
    const cursor = showcase.querySelector('.cursor');
    const code = showcase.dataset.code || '';
    const delay = parseInt(showcase.dataset.delay || '0', 10);
    
    if (!codeElement || !code) return;

    let charIndex = 0;
    
    const getTypingSpeed = () => Math.floor(Math.random() * 40) + 30;

    const typeChar = () => {
      if (charIndex < code.length) {
        codeElement.textContent = code.substring(0, charIndex + 1);
        charIndex++;
        
        if (charIndex < code.length) {
          setTimeout(typeChar, getTypingSpeed());
        } else {
          cursor.style.animation = 'blink 1s step-end infinite';
        }
      }
    };

    setTimeout(() => {
      cursor.style.animation = 'none';
      typeChar();
    }, delay);
  };

  const observer = new IntersectionObserver((entries) => {
    entries.forEach(entry => {
      if (entry.isIntersecting) {
        const showcase = entry.target;
        if (!showcase.classList.contains('typing-started')) {
          showcase.classList.add('typing-started');
          initShowcaseTypewriter(showcase);
        }
      }
    });
  }, { threshold: 0.3 });

  document.addEventListener('DOMContentLoaded', () => {
    document.querySelectorAll('.feature-showcase').forEach(showcase => {
      observer.observe(showcase);
    });
  });
</script>
