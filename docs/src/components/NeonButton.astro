---
const { text = "Pulse" } = Astro.props;
---

<div class="neon-button-demo">
  <button class="bloom-button" material="neon">
    <span class="button-text">{text}</span>
    <span class="button-glow"></span>
    <span class="button-pulse"></span>
  </button>
</div>

<style>
  .neon-button-demo {
    padding: 1rem;
  }

  .bloom-button {
    position: relative;
    background: transparent;
    border: 2px solid #00d4ff;
    border-radius: 12px;
    padding: 1rem 2rem;
    font-size: 1rem;
    font-weight: 600;
    color: #00d4ff;
    cursor: pointer;
    overflow: hidden;
    transition: all 0.3s cubic-bezier(0.23, 1, 0.32, 1);
    text-transform: uppercase;
    letter-spacing: 0.1em;
    min-width: 140px;
  }

  .button-text {
    position: relative;
    z-index: 2;
    transition: color 0.3s ease;
  }

  .button-glow {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background: linear-gradient(135deg, #00d4ff 0%, #8b5cf6 100%);
    opacity: 0;
    transition: opacity 0.3s ease;
    z-index: 1;
    border-radius: 10px;
  }

  .button-pulse {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    width: 100%;
    height: 100%;
    border: 2px solid #00d4ff;
    border-radius: 12px;
    opacity: 0;
    animation: heartbeat 2s ease-in-out infinite;
    pointer-events: none;
  }

  @keyframes heartbeat {
    0%, 100% {
      transform: translate(-50%, -50%) scale(1);
      opacity: 0;
    }
    50% {
      transform: translate(-50%, -50%) scale(1.1);
      opacity: 0.5;
    }
  }

  .bloom-button:hover {
    color: #0d1117;
    border-color: transparent;
    box-shadow: 
      0 0 30px rgba(0, 212, 255, 0.5),
      0 0 60px rgba(0, 212, 255, 0.3);
    transform: translateY(-2px);
  }

  .bloom-button:hover .button-glow {
    opacity: 1;
  }

  .bloom-button:hover .button-pulse {
    border-color: #8b5cf6;
    animation: heartbeat 1s ease-in-out infinite;
  }

  /* Active state */
  .bloom-button:active {
    transform: translateY(0) scale(0.98);
  }

  /* Focus ring */
  .bloom-button:focus {
    outline: none;
    box-shadow: 
      0 0 0 3px rgba(0, 212, 255, 0.3),
      0 0 30px rgba(0, 212, 255, 0.3);
  }
</style>

<script>
  // Add click interaction
  document.querySelectorAll('.bloom-button').forEach(button => {
    button.addEventListener('click', () => {
      button.style.transform = 'scale(0.95)';
      setTimeout(() => {
        button.style.transform = '';
      }, 150);
    });
  });
</script>
